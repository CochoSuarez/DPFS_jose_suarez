<!DOCTYPE html>
<html lang="es">
<%- include('./partials/head') %>
<body>
    <%- include('./partials/header') %>
    
    <main>
        <section class="hero">
            <h2>Sonido Artesanal Premium</h2>
            <p>Explora nuestra curaduría exclusiva de instrumentos y equipos de luthier.</p>
        </section>

        <section class="productos-grid">
            <% products.forEach(producto => { %>
                <article class="producto-card">
                    <img src="/images/products/<%= producto.image %>" alt="<%= producto.name %>">
                    
                    <div class="info">
                        <h3><%= producto.name %></h3>
                        <p class="precio">$<%= producto.price.toLocaleString('es-AR') %></p>
                        
                        <a href="/products/<%= producto.id %>" class="btn-detalle">Ver Detalle</a>
                    </div>
                </article>
            <% }) %>
        </section>
    </main>

    <%- include('./partials/footer') %>
</body>
</html>