<!DOCTYPE html>
<html lang="es">
<%- include('./partials/head') %>
<body>
    <%- include('./partials/header') %>
    
    <main>
        <section class="hero">
            <h2>Sonido Artesanal Premium</h2>
            <p>Explora nuestra curaduría exclusiva de instrumentos y equipos de luthier.</p>
        </section>

        <section class="productos-grid">
            <% products.forEach(producto => { %>
                <article class="producto-card">
                    <img src="<%= producto.image %>" alt="<%= producto.name %>">
                    
                    <div class="info">
                        <p style="font-style: italic; color: #888; font-size: 0.9em; margin-bottom: 5px;">
                            <%= producto.category ? (producto.category.nombre || producto.category.name) : 'Sin categoría' %>
                        </p>

                        <h3><%= producto.name %></h3>
                        <p class="precio">$<%= producto.price ? producto.price.toLocaleString('es-AR') : 'Consultar' %></p>
                        
                        <a href="/products/<%= producto.id %>" class="btn-detalle">Ver Detalle</a>
                    </div>
                </article>
            <% }) %>
        </section>
    </main>

    <%- include('./partials/footer') %>
</body>
</html>