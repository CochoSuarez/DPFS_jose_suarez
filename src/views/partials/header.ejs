<header style="display: flex; justify-content: space-between; align-items: center; padding: 10px 40px;">
    <div class="logo">
        <a href="/"><h1>INSTRUMENTOS BOUTIQUE</h1></a>
    </div>

    <nav style="display: flex; align-items: center; flex-grow: 1;">
        <div style="margin-left: auto; margin-right: auto;">
            <form action="/products/search" method="GET" style="display: inline-block;">
                <input type="text" name="search" placeholder="Buscar instrumentos..." 
                    style="padding: 5px; background: #0f0f0f; border: 1px solid #333; color: white; width: 200px;">
                <button type="submit" style="background: #c4a77d; border: none; padding: 5px 10px; cursor: pointer;">🔍</button>
            </form>
        </div>

        <ul style="display: flex; list-style: none; gap: 15px; align-items: center;">
            <li><a href="/">Home</a></li>

            <% if (locals.isLogged) { %>
                <li><a href="/users/profile">Hola, <%= locals.userLogged.nombre %></a></li>
                
                <li>
                    <a href="/products/create" style="font-style: italic; font-size: 0.85em; color: #c4a77d; border: 1px dashed #c4a77d; padding: 4px 8px; border-radius: 3px; opacity: 0.8; text-decoration: none;">
                        [ Admin: + Nuevo ]
                    </a>
                </li>

                <li><a href="/users/logout">Salir</a></li>
            <% } else { %>
                <li><a href="/users/login">Login</a></li>
                <li><a href="/users/registro">Registro</a></li>
            <% } %>

            <li style="position: relative;">
                <a href="/products/cart" style="text-decoration: none; font-size: 1.2em;">
                    🛒
                    <span class="cart-badge" style="
                        position: absolute; 
                        top: -8px; 
                        right: -8px; 
                        background: #c4a77d; 
                        color: #050505; 
                        border-radius: 50%; 
                        padding: 2px 6px; 
                        font-size: 10px; 
                        font-weight: bold; 
                        display: none;">0</span>
                </a>
            </li>
        </ul>
    </nav>
</header>