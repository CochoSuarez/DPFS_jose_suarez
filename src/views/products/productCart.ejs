<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    
    <main style="padding: 40px; max-width: 1200px; margin: 0 auto;">
        <h2 id="cart-title" style="color: #c4a77d; margin-bottom: 20px; letter-spacing: 2px; text-transform: uppercase;">
            TU CARRITO
        </h2>
        
        <div id="carrito-vacio" style="display: none; text-align: center; padding: 60px; background: #0f0f0f; border: 1px solid #333;">
            <p style="font-size: 1.5em; color: #666;">Tu carrito está vacío.</p>
            <a href="/" style="color: #c4a77d; text-decoration: underline; margin-top: 20px; display: inline-block;">Volver a la tienda</a>
        </div>

        <div class="cart-wrapper" id="cart-content" style="display: flex; gap: 30px; align-items: flex-start;">
            
            <section class="cart-items" id="carrito-body" style="flex: 2;">
                </section>

            <aside class="cart-summary" style="flex: 1; background: #0f0f0f; padding: 25px; border: 1px solid #333; color: white; position: sticky; top: 20px;">
                <h3 style="margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; color: #c4a77d;">Resumen de compra</h3>
                
                <div class="summary-row" style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span>Subtotal:</span>
                    <span id="resumen-subtotal">$0</span>
                </div>
                
                <div class="summary-row" style="font-weight: bold; font-size: 20px; color: #c4a77d; border-top: 1px solid #333; padding-top: 15px; display: flex; justify-content: space-between;">
                    <span>Total:</span>
                    <span id="resumen-total">$0</span>
                </div>

                <button class="btn-checkout" style="width: 100%; background: #c4a77d; color: #050505; border: none; padding: 15px; font-weight: bold; margin-top: 25px; cursor: pointer; letter-spacing: 1px;">
                    FINALIZAR COMPRA
                </button>

                <button onclick="vaciarCarrito()" style="width: 100%; background: none; border: 1px dashed #444; color: #666; padding: 8px; margin-top: 15px; cursor: pointer; font-size: 11px; text-transform: uppercase;">
                    Vaciar todo el carrito
                </button>
            </aside>
        </div>
    </main>

    <%- include('../partials/footer') %>

    
    <script>
        function renderCarrito() {
            let cart = JSON.parse(localStorage.getItem('cart')) || [];
            let emptyMsg = document.getElementById('carrito-vacio');
            let cartContent = document.getElementById('cart-content');
            let cartTitle = document.getElementById('cart-title');
            let body = document.getElementById('carrito-body');
            
            let subtotalDisplay = document.getElementById('resumen-subtotal');
            let totalDisplay = document.getElementById('resumen-total');

            if (cart.length === 0) {
                emptyMsg.style.display = 'block';
                cartContent.style.display = 'none';
                cartTitle.innerText = "TU CARRITO (Vacío)";
            } else {
                emptyMsg.style.display = 'none';
                cartContent.style.display = 'flex';
                
                let totalItemsCount = cart.reduce((total, item) => total + parseInt(item.quantity), 0);
                cartTitle.innerText = `TU CARRITO (${totalItemsCount} ${totalItemsCount === 1 ? 'item' : 'items'})`;
                
                body.innerHTML = '';
                let totalGral = 0;

                cart.forEach((item, index) => {
                    let subtotalItem = item.price * item.quantity;
                    totalGral += subtotalItem;
                    
                    let imgPath = item.image.includes('http') ? item.image : '/images/products/' + item.image;

                    body.innerHTML += `
                        <div class="cart-item" style="display: flex; align-items: center; gap: 20px; background: #0f0f0f; border: 1px solid #333; padding: 20px; margin-bottom: 15px; color: white; position: relative;">
                            <img src="${imgPath}" alt="${item.name}" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #333;">
                            <div style="flex: 1;">
                                <h3 style="margin-bottom: 5px; color: #c4a77d; font-size: 1.1rem;">${item.name}</h3>
                                <div style="display: flex; align-items: center; gap: 15px; margin-top: 10px;">
                                    <label style="font-size: 13px; color: #666;">CANTIDAD:</label>
                                    <input type="number" value="${item.quantity}" min="1" 
                                           onchange="updateQuantity(${index}, this.value)"
                                           style="width: 50px; padding: 5px; background: #1a1a1a; border: 1px solid #444; color: white; text-align: center; border-radius: 3px;">
                                    
                                    <button onclick="removeItem(${index})" 
                                            style="background: none; border: none; color: #666; cursor: pointer; font-size: 11px; margin-left: 20px; text-decoration: underline;"
                                            onmouseover="this.style.color='#fff'" 
                                            onmouseout="this.style.color='#666'">
                                        [ QUITAR ]
                                    </button>
                                </div>
                            </div>
                            <p style="font-weight: bold; font-size: 18px; color: white;">$${subtotalItem.toLocaleString('es-AR')}</p>
                        </div>
                    `;
                });

                subtotalDisplay.innerText = '$' + totalGral.toLocaleString('es-AR');
                totalDisplay.innerText = '$' + totalGral.toLocaleString('es-AR');
            }
        }

        // Nueva función para actualizar cantidades
        function updateQuantity(index, newValue) {
            let cart = JSON.parse(localStorage.getItem('cart')) || [];
            if (newValue < 1) newValue = 1;
            cart[index].quantity = parseInt(newValue);
            localStorage.setItem('cart', JSON.stringify(cart));
            renderCarrito();
            updateCartBadge(); // Actualiza el globito del header
        }

        function removeItem(index) {
            let cart = JSON.parse(localStorage.getItem('cart')) || [];
            cart.splice(index, 1);
            localStorage.setItem('cart', JSON.stringify(cart));
            renderCarrito();
            updateCartBadge();
        }

        function vaciarCarrito() {
            if(confirm('¿Seguro quieres vaciar el carrito?')) {
                localStorage.removeItem('cart');
                renderCarrito();
                updateCartBadge();
            }
        }

        document.addEventListener('DOMContentLoaded', renderCarrito);
    </script>
</body>
</html>