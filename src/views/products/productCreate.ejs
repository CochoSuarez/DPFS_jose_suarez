<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main style="max-width: 600px; margin: 40px auto; background: #1a1a1a; padding: 30px; border: 1px solid #c4a77d;">
        <h2 style="color: #c4a77d; margin-bottom: 20px;">Cargar Nuevo Producto</h2>
        
        <form action="/products" method="POST" enctype="multipart/form-data" class="create-form" style="display: flex; flex-direction: column; gap: 15px;">
            
            <input type="text" name="name" placeholder="Nombre del producto" required style="padding: 10px; background: #0f0f0f; border: 1px solid #333; color: white;">
            
            <textarea name="description" placeholder="Descripción" required style="padding: 10px; background: #0f0f0f; border: 1px solid #333; color: white; min-height: 100px;"></textarea>
            
            <input type="number" name="price" placeholder="Precio" required style="padding: 10px; background: #0f0f0f; border: 1px solid #333; color: white;">
            
            <select name="category" required style="padding: 10px; background: #0f0f0f; border: 1px solid #333; color: white;">
                <option value="">Elegí una categoría</option>
                <option value="electricas">Guitarras Eléctricas</option>
                <option value="acusticas">Guitarras Acústicas</option>
            </select>
            
            <input type="text" name="colors" placeholder="Colores disponibles" style="padding: 10px; background: #0f0f0f; border: 1px solid #333; color: white;">
            
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label style="font-size: 14px; color: #c4a77d;">Imagen del producto:</label>
                <input type="file" name="image" accept="image/*" required style="color: #666;">
            </div>

            <button type="submit" style="background: #c4a77d; padding: 12px; border: none; font-weight: bold; cursor: pointer; margin-top: 10px; color: black; transition: 0.3s;">
                CREAR PRODUCTO
            </button>
        </form>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>