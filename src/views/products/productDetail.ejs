<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
    <%- include('../partials/header') %>

    <main class="detalle-producto-main">
        <section class="contenedor-detalle">
            <div class="bloque-imagen">
                <% 
                    // Lógica para determinar la ruta de la imagen
                    let imagePath = product.image.includes('http') ? product.image : '/images/products/' + product.image;
                %>
                <img src="<%= imagePath %>" 
                     class="producto-detalle-imagen" 
                     alt="<%= product.name %>"
                     onerror="this.onerror=null; this.src='https://via.placeholder.com/500x400/050505/c4a77d?text=Imagen+No+Disponible';">
            </div>

            <div class="bloque-info">
                <p style="text-align: left; font-style: italic; color: #888; margin-bottom: 5px; font-family: inherit;">
                    <%= product.category ? (product.category.nombre || product.category.name) : 'Sin categoría' %>
                </p>
                
                <h1><%= product.name %></h1>
                
                <div class="divisor-dorado"></div>

                <p class="descripcion-texto">
                    <%= product.description %>
                </p>

                <p class="precio-detalle">$<%= product.price ? product.price.toLocaleString('es-AR') : '0' %></p>

                <div class="acciones-compra">
                    <button class="btn-comprar" 
                            onclick="addToCart('<%= product.id %>', '<%= product.name %>', <%= product.price %>, '<%= product.image %>')">
                        AGREGAR AL CARRITO
                    </button>
                    
                    <div class="admin-actions" style="margin-top: 20px;">
                        <a href="/products/<%= product.id %>/edit" class="btn-edit-secundario">
                            Modificar Producto
                        </a>
                        
                        <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="display: inline;">
                            <button type="submit" class="btn-delete-link">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>

    
</body>
</html>