<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil de <%= user.nombre %></title>
    <link rel="stylesheet" href="/css/styles.css"> 
</head>
<body style="background-color: #050505; color: white;"> <%- include('../partials/header') %>

    <main style="padding: 40px; text-align: center;">
        <h1 style="color: #c4a77d; letter-spacing: 2px;">Bienvenido, <%= user.nombre %></h1>
        
        <div class="profile-card" style="margin-top: 30px; background: #0a0a0a; padding: 30px; display: inline-block; border: 1px solid #1a1a1a; border-radius: 10px;">
            <img src="/images/users/<%= user.avatar %>" alt="Avatar" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; border: 2px solid #c4a77d; margin-bottom: 20px;">
            
            <div class="user-info" style="margin-bottom: 30px;">
                <p style="font-size: 1.1em; color: #ccc;"><strong>Email:</strong> <%= user.email %></p>
            </div>

            <div class="actions" style="display: flex; gap: 15px; justify-content: center; align-items: center;">
                <a href="/users/edit/    <%= user.id %>" 
                   style="background-color: #c4a77d; color: black; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; transition: 0.3s;">
                    Editar Perfil
                </a>

                <a href="/users/logout" 
                   style="border: 1px solid #ff4d4d; color: #ff4d4d; padding: 9px 19px; text-decoration: none; border-radius: 5px; font-size: 0.9em;">
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>