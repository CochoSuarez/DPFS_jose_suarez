<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
    <%- include('../partials/header') %>

    <main style="display: flex; justify-content: center; align-items: center; min-height: 80vh; padding: 40px 0;">
        <div class="auth-container" style="background: #1a1a1a; padding: 40px; border: 1px solid #c4a77d; width: 100%; max-width: 450px;">
            <h2 style="color: #c4a77d; text-align: center; margin-bottom: 30px; text-transform: uppercase; letter-spacing: 2px;">Crear Cuenta</h2>
            
            <form action="/users/registro" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 20px;">
                
                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Nombre Completo</label>
                    <input type="text" name="nombre" placeholder="Ej: Juan Perez" required 
                           style="width: 100%; padding: 12px; background: #0f0f0f; border: 1px solid #333; color: white;">
                </div>

                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Correo Electrónico</label>
                    <input type="email" name="email" placeholder="usuario@gmail.com" required 
                           style="width: 100%; padding: 12px; background: #0f0f0f; border: 1px solid #333; color: white;">
                </div>

                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Contraseña</label>
                    <input type="password" name="password" placeholder="Mínimo 6 caracteres" required 
                           style="width: 100%; padding: 12px; background: #0f0f0f; border: 1px solid #333; color: white;">
                </div>

                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Foto de Perfil</label>
                    <input type="file" name="avatar" accept="image/*" 
                           style="width: 100%; color: #666; font-size: 13px; padding: 5px 0;">
                </div>
                
                <button type="submit" style="background: #c4a77d; color: black; padding: 15px; border: none; font-weight: bold; cursor: pointer; transition: 0.3s; margin-top: 10px;">
                    REGISTRARME
                </button>
            </form>
            
            <p style="text-align: center; margin-top: 25px; font-size: 13px; color: #666;">
                ¿Ya tenés cuenta? <a href="/users/login" style="color: #c4a77d; text-decoration: none; font-weight: bold;">Iniciá sesión</a>
            </p>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>