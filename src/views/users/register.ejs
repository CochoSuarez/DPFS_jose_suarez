<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
    <%- include('../partials/header') %>

    <main style="display: flex; justify-content: center; align-items: center; min-height: 80vh; padding: 40px 0;">
        <div class="auth-container" style="background: #1a1a1a; padding: 40px; border: 1px solid #c4a77d; width: 100%; max-width: 450px;">
            <h2 style="color: #c4a77d; text-align: center; margin-bottom: 30px; text-transform: uppercase; letter-spacing: 2px;">Crear Cuenta</h2>
            
            <form id="registerForm" action="/users/registro" method="POST" enctype="multipart/form-data" novalidate style="display: flex; flex-direction: column; gap: 20px;">
                
                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Nombre Completo</label>
                    <input type="text" name="nombre" id="nombre" placeholder="Ej: Juan Perez" 
                           value="<%= locals.oldData ? oldData.nombre : null %>"
                           style="width: 100%; padding: 12px; background: #0f0f0f; border: 1px solid <%= locals.errors && errors.nombre ? '#ff4d4d' : '#333' %>; color: white;">
                    <p id="error-nombre" style="color: #ff4d4d; font-size: 12px; margin-top: 5px; display: none;"></p>
                    <% if (locals.errors && errors.nombre) { %>
                        <p style="color: #ff4d4d; font-size: 12px; margin-top: 5px;"><%= errors.nombre.msg %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Correo Electrónico</label>
                    <input type="email" name="email" id="email" placeholder="usuario@gmail.com" 
                           value="<%= locals.oldData ? oldData.email : null %>"
                           style="width: 100%; padding: 12px; background: #0f0f0f; border: 1px solid <%= locals.errors && errors.email ? '#ff4d4d' : '#333' %>; color: white;">
                    <p id="error-email" style="color: #ff4d4d; font-size: 12px; margin-top: 5px; display: none;"></p>
                    <% if (locals.errors && errors.email) { %>
                        <p style="color: #ff4d4d; font-size: 12px; margin-top: 5px;"><%= errors.email.msg %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Contraseña</label>
                    <input type="password" name="password" id="password" placeholder="Mínimo 8 caracteres" 
                           style="width: 100%; padding: 12px; background: #0f0f0f; border: 1px solid <%= locals.errors && errors.password ? '#ff4d4d' : '#333' %>; color: white;">
                    <p id="error-password" style="color: #ff4d4d; font-size: 12px; margin-top: 5px; display: none;"></p>
                    <% if (locals.errors && errors.password) { %>
                        <p style="color: #ff4d4d; font-size: 12px; margin-top: 5px;"><%= errors.password.msg %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label style="color: #666; font-size: 12px; display: block; margin-bottom: 5px;">Foto de Perfil</label>
                    <input type="file" name="avatar" id="avatar" accept="image/*" 
                           style="width: 100%; color: #666; font-size: 13px; padding: 5px 0;">
                    <p id="error-avatar" style="color: #ff4d4d; font-size: 12px; margin-top: 5px; display: none;"></p>
                    <% if (locals.errors && errors.avatar) { %>
                        <p style="color: #ff4d4d; font-size: 12px; margin-top: 5px;"><%= errors.avatar.msg %></p>
                    <% } %>
                </div>
                
                <button type="submit" style="background: #c4a77d; color: black; padding: 15px; border: none; font-weight: bold; cursor: pointer; transition: 0.3s; margin-top: 10px;">
                    REGISTRARME
                </button>
            </form>
            
            <p style="text-align: center; margin-top: 25px; font-size: 13px; color: #666;">
                ¿Ya tenés cuenta? <a href="/users/login" style="color: #c4a77d; text-decoration: none; font-weight: bold;">Iniciá sesión</a>
            </p>
        </div>
    </main>

    <%- include('../partials/footer') %>
    
    <script src="/js/userRegisterValidation.js"></script>
</body>
</html>